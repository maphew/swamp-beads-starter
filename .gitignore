# BEGIN swamp managed section - DO NOT EDIT

# Runtime data (not needed in version control)
.swamp/

# Local extension sources (developer-specific, not shared)
.swamp-sources.yaml
# END swamp managed section

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Per-clone agent config (never shared, whatever tool is enrolled)
.claude/settings.local.json

# Generated by `bd init`/`bd setup` for every CLI it detects. Re-create with
# `bd setup <tool>`; never commit, or every checkout differs by machine.
.codex/
.cursor/

# setup.sh repair backups (safe to delete)
*.pre-setup.bak
